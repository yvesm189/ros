# Typography and language support.
# ROS targets English / French / Kinyarwanda institutions, so the font stack has
# to cover Latin-extended well and the locale list is generated at build time.
locales
fonts-inter
fonts-cantarell
fonts-noto-core
fonts-noto-color-emoji
fonts-liberation2
fonts-dejavu
hunspell-en-us
hunspell-fr
