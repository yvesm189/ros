[Unit]
Description=Prepare the ROS desktop preview
Documentation=https://github.com/yvesm189/ros
After=systemd-logind.service dbus.service network-online.target
Wants=systemd-logind.service
Before=lightdm.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/ros-desktop-preview
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
