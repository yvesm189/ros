# ROS boot splash.
# logo.png is generated from /usr/share/pixmaps/ros-logo.svg at image build time
# (see base/live-build/config/hooks/normal/0400-plymouth-theme.hook.chroot) so
# that the repository stays free of generated binaries.

# Background gradient, matching the ROS wallpaper.
Window.SetBackgroundTopColor(0.023, 0.141, 0.227);     # #06243A
Window.SetBackgroundBottomColor(0.039, 0.310, 0.478);  # #0A4F7A

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = screen_width / 2 - logo.image.GetWidth() / 2;
logo.y = screen_height / 2 - logo.image.GetHeight() / 2 - 40;
logo.sprite.SetPosition(logo.x, logo.y, 0);

# --- progress dots -----------------------------------------------------------
dot_count = 5;
dot_radius = 5;
dot_gap = 26;
dot_y = logo.y + logo.image.GetHeight() + 60;

fun make_dot(alpha) {
    dot = Image.Text(".", 1, 1, 1, alpha, "Sans 28");
    return dot;
}

for (i = 0; i < dot_count; i++) {
    dots[i].sprite = Sprite();
    dots[i].x = screen_width / 2 - ((dot_count - 1) * dot_gap) / 2 + i * dot_gap;
    dots[i].sprite.SetPosition(dots[i].x, dot_y, 1);
}

progress = 0;

fun refresh_callback() {
    progress++;
    for (i = 0; i < dot_count; i++) {
        phase = (progress / 6 + i) % dot_count;
        alpha = 0.2 + 0.8 * (phase == 0);
        dots[i].sprite.SetImage(make_dot(alpha));
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

# --- messages ----------------------------------------------------------------
message_sprite = Sprite();
message_sprite.SetPosition(0, screen_height - 90, 10);

fun message_callback(text) {
    image = Image.Text(text, 1, 1, 1, 0.75, "Sans 11");
    message_sprite.SetImage(image);
    message_sprite.SetX(screen_width / 2 - image.GetWidth() / 2);
}
Plymouth.SetMessageFunction(message_callback);

fun display_normal_callback() {
    prompt_sprite.SetImage(Image.Text("", 0, 0, 0, 0, "Sans 11"));
    bullet_sprite.SetImage(Image.Text("", 0, 0, 0, 0, "Sans 11"));
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

# --- disk unlock / password prompt -------------------------------------------
prompt_sprite = Sprite();
bullet_sprite = Sprite();

fun display_password_callback(prompt, bullets) {
    text = Image.Text(prompt, 1, 1, 1, 1, "Sans 12");
    prompt_sprite.SetImage(text);
    prompt_sprite.SetPosition(screen_width / 2 - text.GetWidth() / 2,
                              dot_y + 40, 10);

    stars = "";
    for (i = 0; i < bullets; i++) {
        stars += "*";
    }
    star_image = Image.Text(stars, 1, 1, 1, 1, "Sans 14");
    bullet_sprite.SetImage(star_image);
    bullet_sprite.SetPosition(screen_width / 2 - star_image.GetWidth() / 2,
                              dot_y + 80, 10);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun quit_callback() {
    logo.sprite.SetOpacity(0);
}
Plymouth.SetQuitFunction(quit_callback);
