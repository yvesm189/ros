# Look and feel.
[org/gnome/desktop/interface]
color-scheme='prefer-dark'
accent-color='blue'
gtk-theme='Adwaita'
icon-theme='Adwaita'
cursor-theme='Adwaita'
font-name='Funnel Display 11'
document-font-name='Funnel Display 11'
monospace-font-name='monospace 11'
font-antialiasing='grayscale'
font-hinting='slight'
clock-show-weekday=true
clock-show-date=true
clock-format='24h'
show-battery-percentage=true
enable-hot-corners=false

[org/gnome/desktop/wm/preferences]
# Close button on the right, with minimise and maximise: ROS is mostly a
# migration target for Windows users and this is the single change that removes
# the most "where did the button go" support tickets.
button-layout='appmenu:minimize,maximize,close'
titlebar-font='Funnel Display SemiBold 11'
action-middle-click-titlebar='minimize'

[org/gnome/mutter]
dynamic-workspaces=true
edge-tiling=true
center-new-windows=true
