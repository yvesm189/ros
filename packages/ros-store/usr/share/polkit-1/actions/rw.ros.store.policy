<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<policyconfig>

  <vendor>ROS</vendor>
  <vendor_url>https://github.com/yvesm189/ros</vendor_url>

  <!--
    The ROS Store runs as the person at the keyboard and shells out to the
    agent through pkexec for anything that changes the system. The agent only
    accepts a catalogue slug, so this authorisation cannot be turned into
    "install an arbitrary package".
  -->
  <action id="rw.ros.store.manage-applications">
    <description>Install or remove a ROS application</description>
    <message>Authentication is required to change the applications on this workstation</message>
    <icon_name>package-x-generic</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/ros-agent</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

</policyconfig>
